<nav class="bg-white border-b border-gray-200 fixed w-full z-20 top-0 start-0">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href="/" class="flex items-center space-x-3">
      <span class="self-center text-xl font-bold tracking-tight text-gray-900">BEGIN</span>
    </a>
    <div class="flex items-center md:order-2 space-x-3">
      <% if (locals.user) { %>
        <div class="flex items-center space-x-3">
          <span class="text-sm font-medium text-gray-700 bg-gray-100 px-3 py-1.5 rounded-full">
            <%= (user.fullName || user.email) %>
          </span>
          <a href="/api/auth/logout" class="text-sm text-red-600 hover:text-red-700 font-medium px-3 py-1.5 border border-red-200 hover:border-red-300 rounded-lg transition">
            Log out
          </a>
        </div>
      <% } else { %>
        <div class="flex items-center space-x-2">
          <a href="/auth/login" class="text-sm font-medium text-gray-700 hover:text-gray-900 px-3 py-2 rounded-lg hover:bg-gray-100 transition">
            Sign In
          </a>
          <a href="/auth/signup" class="text-sm font-medium text-white bg-black hover:bg-gray-800 px-3.5 py-2 rounded-lg transition">
            Create Account
          </a>
        </div>
      <% } %>
    </div>
