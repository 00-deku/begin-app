<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <title>Complete Profile | Begin</title>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col pt-20">
    <%- include('../partials/nav') %>

    <main class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-lg bg-white border border-gray-200 rounded-2xl shadow-sm p-8">
            <div class="text-center mb-6">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">Step 2 of 2</span>
                <h1 class="text-2xl font-bold tracking-tight mt-1">Set up your profile</h1>
                <p class="text-sm text-gray-500 mt-1">
                    Joined as: 
                    <span class="font-semibold text-black px-2 py-0.5 bg-gray-100 rounded text-xs">
                        <%= role === 'BOTH' ? 'Founder & Builder' : role %>
                    </span>
                </p>
            </div>

            <form id="profileForm" class="space-y-4">
                <!-- Common for EVERYONE -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                    <input type="text" id="fullName" required placeholder="Alex Sharma" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-black">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">College / University</label>
                    <input type="text" id="college" required placeholder="e.g. Stanford / IIT / BITS" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-black">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Bio</label>
                    <textarea id="bio" rows="2" placeholder="Brief one-liner about what you're building or interested in" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-black"></textarea>
                </div>

                <!-- 1. FOUNDER SECTION: Shows ONLY for FOUNDER or BOTH -->
                <% if (role === 'FOUNDER' || role === 'BOTH') { %>
                <div class="p-4 bg-orange-50 border border-orange-200 rounded-xl space-y-3">
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-orange-800">Founder Details</span>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Startup / Project Name</label>
                        <input type="text" id="startupName" placeholder="e.g. Acme.ai" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Current Stage</label>
                        <select id="stage" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
                            <option value="Idea">Just an Idea</option>
                            <option value="Building MVP">Building Prototype / MVP</option>
                            <option value="Launched">Launched & has users</option>
                        </select>
                    </div>
                </div>
                <% } %>

                <!-- 2. JOINER SECTION: Shows ONLY for JOINER or BOTH -->
                <% if (role === 'JOINER' || role === 'BOTH') { %>
                <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl space-y-3">
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-blue-800">Skills & Interests</span>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Your Skills (comma-separated)</label>
                        <input type="text" id="skills" placeholder="React, Node.js, UI Design" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
                    </div>
                </div>
                <% } %>

                <button type="submit" id="submitBtn" class="w-full bg-black text-white font-medium py-2.5 rounded-lg text-sm hover:bg-gray-800 transition mt-6">
                    Complete Setup & Go to Home
                </button>
            </form>
        </div>
    </main>

    <script>
        const form = document.getElementById("profileForm");
        const submitBtn = document.getElementById("submitBtn");

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            submitBtn.disabled = true;
            submitBtn.textContent = "Saving profile...";

            const body = {
                fullName: document.getElementById("fullName").value,
                college: document.getElementById("college").value,
                bio: document.getElementById("bio").value,
                startupName: document.getElementById("startupName") ? document.getElementById("startupName").value : "",
                stage: document.getElementById("stage") ? document.getElementById("stage").value : "",
                skills: document.getElementById("skills") ? document.getElementById("skills").value : "",
            };

            const res = await fetch("/onboarding/profile", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body)
            });

            const data = await res.json();
            if (res.ok) {
                window.location.href = data.nextStep || "/";
            } else {
                alert(data.message || "Failed to save profile");
                submitBtn.disabled = false;
                submitBtn.textContent = "Complete Setup & Go to Home";
            }
        });
    </script>
</body>
</html>
