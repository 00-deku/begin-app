<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <title>Create Startup Page | Begin</title>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col pt-20">
    <%- include('../partials/nav') %>

    <main class="flex-1 max-w-2xl w-full mx-auto p-6 space-y-6">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">Create Startup Page</h1>
            <p class="text-sm text-gray-500 mt-1">Publish your project to recruit teammates, post open roles, and share milestone updates.</p>
        </div>

        <div id="statusMessage" class="hidden p-3 rounded-lg text-sm"></div>

        <form id="createStartupForm" class="space-y-5 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Startup / Project Name</label>
                <input type="text" id="name" required placeholder="e.g. CampusCart, PeerPrep" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-black" />
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block text-xs font-medium text-gray-700">One-Line Pitch (Max 200 characters)</label>
                    <span id="pitchCount" class="text-xs text-gray-400">0 / 200</span>
                </div>
                <input type="text" id="pitch" required maxlength="200" placeholder="e.g. Peer-to-peer textbook and gadget exchange for verified students" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-black" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Development Stage</label>
                    <select id="stage" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="Idea">Idea</option>
                        <option value="Building MVP">Building MVP</option>
                        <option value="Launched">Launched</option>
                        <option value="Has users">Has users</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1">Visibility Mode (M3.4)</label>
                    <select id="visibility" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="PUBLIC">Public to verified members</option>
                        <option value="STEALTH">Stealth (name & pitch hidden, roles visible)</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Industry Tags (comma-separated)</label>
                <input type="text" id="industryTags" placeholder="e.g. EdTech, FinTech, AI, Logistics" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-black" />
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">The Problem We Are Solving</label>
                <textarea id="problem" rows="3" placeholder="What core friction or challenge on campus or in the market are you tackling?" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-black"></textarea>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Our Solution</label>
                <textarea id="solution" rows="3" placeholder="How does your product or approach solve this problem?" class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-black"></textarea>
            </div>

            <div class="pt-3 border-t border-gray-100">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">Project Links</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <input type="url" id="linkWebsite" placeholder="Website URL" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                    <input type="url" id="linkDemo" placeholder="Live Demo / Prototype URL" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                    <input type="url" id="linkPitchDeck" placeholder="Pitch Deck URL" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                    <input type="url" id="linkGithub" placeholder="GitHub Repository URL" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" />
                </div>
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                <a href="/startup" class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50 transition">
                    Cancel
                </a>
                <button type="submit" id="submitBtn" class="px-5 py-2 bg-black text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition">
                    Publish Startup Page
                </button>
            </div>
        </form>
    </main>

    <script>
        const pitchInput = document.getElementById("pitch");
        const pitchCount = document.getElementById("pitchCount");
        if (pitchInput && pitchCount) {
            pitchInput.addEventListener("input", () => {
                pitchCount.textContent = pitchInput.value.length + " / 200";
            });
        }

        const form = document.getElementById("createStartupForm");
        const statusEl = document.getElementById("statusMessage");

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const payload = {
                name: document.getElementById("name").value,
                pitch: document.getElementById("pitch").value,
                stage: document.getElementById("stage").value,
                visibility: document.getElementById("visibility").value,
                industryTags: document.getElementById("industryTags").value,
                problem: document.getElementById("problem").value,
                solution: document.getElementById("solution").value,
                links: {
                    website: document.getElementById("linkWebsite").value,
                    demo: document.getElementById("linkDemo").value,
                    pitchDeck: document.getElementById("linkPitchDeck").value,
                    github: document.getElementById("linkGithub").value,
                },
            };

            try {
                const res = await fetch("/startup/api", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = data.redirectUrl || "/startup";
                } else {
                    statusEl.className = "p-3 rounded-lg text-sm bg-red-50 text-red-700 border border-red-200";
                    statusEl.textContent = data.message || "Failed to create startup page.";
                    statusEl.classList.remove("hidden");
                }
            } catch (err) {
                statusEl.className = "p-3 rounded-lg text-sm bg-red-50 text-red-700 border border-red-200";
                statusEl.textContent = "Network error creating startup.";
                statusEl.classList.remove("hidden");
            }
        });
    </script>
</body>
</html>
